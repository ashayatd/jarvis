# Copy to .env and fill in. Both the Node service and executor.py read it.

# --- Node service --------------------------------------------------------
PORT=3000

# --- LLM: Groq primary, local Ollama fallback ----------------------------
# Which provider is asked first: "groq" (default) or "ollama". The other one
# is the fallback.
LLM_PRIMARY=groq

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# How long to wait for Groq before failing over. Groq normally answers in
# well under a second; every millisecond here comes out of Alexa's ~8s budget.
GROQ_TIMEOUT_MS=2000
# Make one tiny Groq call at start, so the first real turn is not a cold one.
GROQ_WARMUP=true

# Ollama's OpenAI-compatible endpoint, and the model it serves.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
# How long the local model stays loaded after a call ("-1" = forever).
# Loading it from disk is far slower than a spoken turn.
OLLAMA_KEEP_ALIVE=30m
# Load the model when the server starts. Set to false on a machine without Ollama.
OLLAMA_WARMUP=true
# A local answer that outlives the turn deadline is finished as a background
# job, so this can be long.
OLLAMA_TIMEOUT_MS=60000
# Only for a reasoning model such as gpt-oss ("low" fits a spoken turn).
# OLLAMA_REASONING_EFFORT=low
OLLAMA_MAX_TOKENS=1024

# After a Groq failure, skip Groq for this long before trying it again. A 429
# that says when to retry (retry-after) is used instead.
BREAKER_COOLDOWN_MS=60000

# --- Time budget (Alexa gives ~8s per turn) ------------------------------
# A single tool slower than this is handed to the job registry.
TOOL_DEADLINE_MS=3500
# A whole turn slower than this is handed to the job registry.
TURN_DEADLINE_MS=4000

# --- PC executor -----------------------------------------------------------
EXECUTOR_URL=http://127.0.0.1:5000/execute
# Required. The executor refuses to start without it. Use a long random value,
# e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
EXECUTOR_SECRET=
# Workspace every command, VS Code and the Claude CLI run in.
EXECUTOR_WORKDIR=C:/projects/alexaProjects
EXECUTOR_TIMEOUT_MS=4000
EXECUTOR_BG_TIMEOUT_MS=120000
EXECUTOR_JOB_TIMEOUT_MS=900000
